# Python
__pycache__/
*.py[cod]
*.egg-info/
# PyInstaller intermediates + build outputs — under tmp/ (already ignored);
# mac/ lin/ win/ hold build code only, never binaries.
# Safety nets for stray binaries in the remaining platform dirs.
lin/forge
win/forge.exe
.venv/
venv/

# Models — downloaded at runtime (~9.7 GB), kept locally only
ai_models/
*.gguf

# Test & generation output — kept locally only
tmp/
output/
*.story

# Safety nets: generated state belongs under tmp/, never platform source trees.
pytest-of-*/
droid/.gradle/
droid/.kotlin/
droid/app/.cxx/
droid/app/build/
ios/.build/
ios/build/
ios/llama/build/
ios/llama/lib/
ios/llama/source/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Screenshots (accidentally dropped in project root)
Screenshot *.png

# Secrets
.env
*.key
*.pem

# Coverage
htmlcov/
.coverage
*.cover

# Checkpoints
*.db
pipeline_events.jsonl

# PyInstaller outputs are configured under tmp/ by every platform wrapper.
