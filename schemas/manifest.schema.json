{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://storyteller.app/schemas/manifest.schema.json",
  "title": "Story Manifest",
  "description": "Top-level metadata for a .story package. Canonical fields identify the artifact; meta fields are operational.",
  "type": "object",
  "required": ["schema_version", "story_id", "title", "generator_version", "models_used", "prompt_versions", "entry_point", "files", "provenance"],
  "properties": {
    "_comment": "── Canonical fields (artifact identity) ──",
    "schema_version": {"type": "integer", "const": 1},
    "story_id": {"type": "string", "format": "uuid"},
    "title": {"type": "string", "minLength": 1},
    "tone": {"type": "string"},
    "seed": {"type": "integer"},
    "generator_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "models_used": {
      "type": "object",
      "required": ["text_generator", "validator", "image_generator", "music_generator"],
      "properties": {
        "text_generator": {"type": "string"},
        "validator": {"type": "string"},
        "image_generator": {"type": "string"},
        "music_generator": {"type": "string"}
      }
    },
    "prompt_versions": {
      "type": "object",
      "description": "Exact prompt template versions used for each pipeline step.",
      "required": ["world_builder", "story_writer", "game_designer", "art_director", "composer"],
      "properties": {
        "world_builder": {"type": "string", "pattern": "^v\\d+$"},
        "story_writer": {"type": "string", "pattern": "^v\\d+$"},
        "game_designer": {"type": "string", "pattern": "^v\\d+$"},
        "art_director": {"type": "string", "pattern": "^v\\d+$"},
        "composer": {"type": "string", "pattern": "^v\\d+$"},
        "style_bible": {"type": "string", "pattern": "^v\\d+$"}
      }
    },
    "entry_point": {"type": "string", "pattern": "^node_\\d{2}$"},
    "files": {
      "type": "object",
      "required": ["bible", "story", "graph", "gm_index", "images", "midi"],
      "properties": {
        "bible": {"type": "string", "const": "content/bible.json"},
        "style_bible": {"type": "string", "const": "content/style_bible.json"},
        "story": {"type": "string", "const": "content/story.json"},
        "graph": {"type": "string", "const": "content/graph.json"},
        "gm_index": {"type": "string", "const": "content/gm_index.json"},
        "images": {"type": "string", "const": "content/images/"},
        "midi": {"type": "string", "const": "content/midi/"},
        "thumbnails": {"type": "string", "const": "content/thumbnails/"}
      }
    },
    "content_hash": {
      "type": "string",
      "description": "SHA256 hash of all content/ files for integrity verification."
    },
    "_comment_provenance": "── Provenance (Phase 5.6X): why does this artifact exist? ──",
    "provenance": {
      "type": "object",
      "required": ["inventory", "depends_on", "produced_by"],
      "properties": {
        "inventory": {
          "type": "object",
          "description": "X1: content-derived canonical artifact ID per artifact key.",
          "required": ["bible", "style_bible", "story", "graph", "images", "midi", "gm_index"],
          "additionalProperties": {
            "type": "string",
            "pattern": "^(world_|style_|story_|graph_|img_|mid_|gmindex_)[a-f0-9]{8}$"
          }
        },
        "depends_on": {
          "type": "object",
          "description": "X2: upstream artifact IDs each artifact was derived from.",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "produced_by": {
          "type": "object",
          "description": "X3: model + prompt version that produced each artifact.",
          "additionalProperties": {
            "type": "object",
            "required": ["model", "model_hash", "prompt_version"],
            "properties": {
              "model": {"type": "string"},
              "model_hash": {"type": "string"},
              "prompt_version": {"type": "string"}
            }
          }
        }
      }
    },

    "_comment_stats": "── Canonical stats (content-derived, same for identical seeds) ──",
    "stats": {
      "type": "object",
      "properties": {
        "total_nodes": {"type": "integer"},
        "total_images": {"type": "integer"},
        "total_midi": {"type": "integer"},
        "total_endings": {"type": "integer"}
      }
    },

    "_comment_meta": "── Operational metadata (varies between runs, NOT part of artifact identity) ──",
    "meta": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "description": "Set by the packager; empty during build-time validation. PackageAcceptance enforces non-empty on final packages.",
          "pattern": "^$|^package_[a-f0-9]{8}$"
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "run_id": {"type": "string"},
        "generation_time_seconds": {"type": "number"},
        "peak_ram_mb": {"type": "number"}
      }
    }
  }
}
