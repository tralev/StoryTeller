{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://storyteller.app/schemas/style_bible.schema.json",
  "title": "Style Bible",
  "description": "Art style constraints for consistent image generation across all scenes.",
  "type": "object",
  "required": ["schema_version", "art_style", "character_design", "location_palettes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generator_version": {"type": "string"},
    "pipeline_version": {"type": "integer"},
    "created_at": {"type": "string", "format": "date-time"},
    "seed": {"type": "integer"},
    "art_style": {
      "type": "object",
      "required": ["palette", "lighting", "composition", "linework", "mood", "forbidden"],
      "properties": {
        "palette": {"type": "string"},
        "lighting": {"type": "string"},
        "composition": {"type": "string"},
        "linework": {"type": "string"},
        "mood": {"type": "string"},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "character_design": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Key: character_id, Value: visual description for image prompts"
    },
    "location_palettes": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Key: location_id, Value: visual description for image prompts"
    }
  }
}
