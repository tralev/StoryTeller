  "validator_rules": [
    {"id":"VAL-ZIP-CONTAINER","source":"package-v2.md#media-type-and-container","reason":"the transport must parse as a ZIP archive before member-level schema validation"},
    {"id":"VAL-ROOT-MANIFEST","source":"package-v2.md#media-type-and-container","reason":"manifest.json presence and exact root placement require archive-member inspection"},
    {"id":"VAL-UNSUPPORTED-VERSION-GUIDANCE","source":"package-v2.md#compatibility","reason":"all validators must reject v1 with stable guidance to regenerate the package as v2"},
    {"id":"VAL-NO-SILENT-COERCION","source":"api.md#compatibility-policy","reason":"validators must reject incompatible representations rather than silently rewriting them into v2"},
    {"id":"VAL-TRUSTED-SCHEMA-PARITY","source":"api.md#compatibility-policy","reason":"Python, Kotlin, and Swift must enforce the same bundled trusted v2 schema identity and rules"},
    {"id":"VAL-JSON-DEPTH-LIMIT","source":"package-v2.md#frozen-parser-and-resource-limits","reason":"bounded parsing must reject JSON nested beyond 128 levels"},
    {"id":"VAL-ZIP-ENTRY-LIMIT","source":"package-v2.md#frozen-parser-and-resource-limits","reason":"central-directory inspection must reject archives with more than 100000 entries"},
    {"id":"VAL-ZIP-MEMBER-SIZE-LIMIT","source":"package-v2.md#frozen-parser-and-resource-limits","reason":"declared uncompressed size of every archive member is limited to 4 GiB"},
    {"id":"VAL-ZIP-TOTAL-SIZE-LIMIT","source":"package-v2.md#frozen-parser-and-resource-limits","reason":"sum of declared uncompressed member sizes is limited to 32 TiB with overflow-safe arithmetic"},
    {"id":"VAL-ZIP-COMPRESSION-RATIO","source":"package-v2.md#frozen-parser-and-resource-limits","reason":"nonempty members must not exceed 1000 to 1 uncompressed-to-compressed amplification"},
    {"id":"VAL-EXTRACTION-FREE-SPACE","source":"package-v2.md#frozen-parser-and-resource-limits","reason":"publication requires free space for all declared members plus atomic staging"},
    {"id":"VAL-ZIP-LINK-PROHIBITION","source":"package-v2.md#forbidden-entries","reason":"archive metadata inspection must reject symbolic and other non-regular link entries"},
    {"id":"VAL-CANONICAL-ARRAY-ORDER","source":"package-v2.md#canonical-json-profile","reason":"JSON Schema cannot compare adjacent array elements"},
    {"id":"VAL-EVENT-ORDER","source":"api.md#world-history-event-contract","reason":"year, sequence, and ID tuple ordering is cross-item"},
    {"id":"VAL-EARLIER-CAUSES","source":"package-v2.md#social-and-history-domains","reason":"cause IDs must resolve to earlier event records"},
    {"id":"VAL-SNAPSHOT-CADENCE","source":"package-v2.md#social-and-history-domains","reason":"required years depend on manifest present_year"},
    {"id":"VAL-SOURCE-COVERAGE-BIJECTION","source":"package-v2.md#required-layout","reason":"ledger rows must equal archive members and world index domains"},
    {"id":"VAL-ARTIFACT-DEPENDENCY-DAG","source":"package-v2.md#artifact-record","reason":"acyclicity and declared-ID resolution are cross-record constraints"},
    {"id":"VAL-ARTIFACT-FILE-BIJECTION","source":"package-v2.md#artifact-record","reason":"archive members and artifact records must form an exact bijection"},
    {"id":"VAL-ARTIFACT-JCS-DERIVATION","source":"package-v2.md#artifact-record","reason":"artifact IDs require canonicalization, hashing, duplicate detection, and full-digest collision checks"},
    {"id":"VAL-CONTENT-HASH-DERIVATION","source":"package-v2.md#artifact-record","reason":"content hash and story ID are computed across canonically reduced and ordered artifact records"},
    {"id":"VAL-INTERNAL-FILE-HASHES","source":"package-v2.md#artifact-record","reason":"declared hashes must equal bytes read back from every internal archive member"},
    {"id":"VAL-FEATURE-ORDER","source":"package-v2.md#v2-feature-registry","reason":"UTF-8 byte ordering compares adjacent feature identifiers"},
    {"id":"VAL-OPTIONAL-FEATURE-SEMANTICS","source":"package-v2.md#v2-feature-registry","reason":"ignorable additive semantics and unchanged interpretation are compatibility policy"},
    {"id":"VAL-SCORE-BEAT-ARITHMETIC","source":"api.md#model-ports","reason":"reduction and exact 960-PPQ representation require arithmetic"},
    {"id":"VAL-SCORE-MARKER-ORDER","source":"api.md#model-ports","reason":"marker monotonicity and duration containment compare fields"},
    {"id":"VAL-SCORE-EVENT-SHAPE","source":"api.md#model-ports","reason":"pitch, velocity, and value rules depend on event kind"},
    {"id":"VAL-SCORE-EVENT-ORDER","source":"api.md#model-ports","reason":"canonical event order and ID uniqueness are cross-item rules"},
    {"id":"VAL-SCORE-TRACK-PROGRAM","source":"api.md#model-ports","reason":"program validity depends on drum-channel role"},
    {"id":"VAL-SCORE-MIDI-HASH","source":"package-v2.md#media","reason":"expected hash must equal deterministically rendered MIDI bytes"},
